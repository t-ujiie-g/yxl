// The CLI's testable core: argument parsing and the I/O-free compile pipeline
// (source string -> .xlsx bytes). All filesystem access and process exit live in
// the `cmd/main` executable, not here (ADR-003), so this package unit-tests
// without touching the disk.
import {
  "t-ujiie-g/yxl/include",
  "t-ujiie-g/yxl/internal/yaml",
  "t-ujiie-g/yxl/internal/loader",
  "t-ujiie-g/yxl/internal/emit",
  "t-ujiie-g/yxl/internal/read",
  "t-ujiie-g/yxl/internal/render",
  "t-ujiie-g/yxl/internal/model",
  "t-ujiie-g/yxl/internal/diag",
  // A companion file is bytes, whatever it holds; a CSV is text encoded once.
  "moonbitlang/core/encoding/utf8",
  // `extends.mbt` names `@debug.Debug` to decline its promotion.
  "moonbitlang/core/debug",
}

// The golden test re-opens compiled bytes with the backend reader to assert the
// cells survived the whole pipeline; the compile benchmark times each pipeline
// stage on its own, so it names them individually.
import {
  "moonbitlang/mbtexcel/xlsx",
  "moonbitlang/core/bench",
  "t-ujiie-g/yxl/internal/yaml",
  "t-ujiie-g/yxl/internal/loader",
  "t-ujiie-g/yxl/internal/emit",
} for "test"
