// Document tree -> model, with schema validation. Turns a `yaml.Node` into a
// `model.Workbook`, rejecting unknown keys, wrong types, and bad cell
// references as `@diag.SchemaError`s (ADR-006). Pure: no filesystem access.
import {
  "t-ujiie-g/yxl/include",
  "t-ujiie-g/yxl/internal/yaml",
  "t-ujiie-g/yxl/internal/model",
  "t-ujiie-g/yxl/internal/units",
  "t-ujiie-g/yxl/internal/diag",
  "moonbitlang/core/string",
  // JSON data tables; the format has a parser in core, unlike CSV.
  "moonbitlang/core/json",
}

// `debug_inspect` renders the workbook model (which derives `Debug`) in tests.
import {
  "moonbitlang/core/debug",
  "t-ujiie-g/yxl/include",
} for "test"
