.DS_Store
_build/
target/
target
examples/*/out/
.mooncakes/
.moonagent/
.claude/*.local.json
*.coverage
# Compiled workbooks. `yxl build` writes these, so one lands in the tree
# whenever an example is compiled by hand; none belongs in the repository.
*.xlsx
# The Open XML validator's build output. The tool is two source files; what
# `dotnet build` makes of them is a runner's or a laptop's business.
tools/openxml-validator/bin/
tools/openxml-validator/obj/
# `.github/scripts/package.sh` output — release archives and their staging
# directory, whether it ran on a runner or locally to rehearse a release.
yxl-*.tar.gz
yxl-*.zip
yxl-*.sha256
yxl-[0-9]*-*/
yxl-unpacked/
